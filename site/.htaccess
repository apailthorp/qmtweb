# Cache policy for AccuWeb's LiteSpeed server (Apache-compatible .htaccess).
#
# By default the host sends a 7-day, non-revalidating cache on static assets
# (Cache-Control: public, max-age=604800), which hides a deploy from returning
# visitors for up to a week. Force revalidation on markup + code so every
# deploy is picked up immediately. Last-Modified makes this cheap: unchanged
# files return 304 (no body), changed files return a fresh 200.
#
# This revalidation is what busts the whole unbundled ES-module graph (deep
# imports included) on each release — the single site version (shown in the
# bottom-left tag) is the human-facing/traceable marker, not the cache key.
#
# Full design + troubleshooting: docs/VERSIONING.md
<IfModule mod_headers.c>
  # --- Security headers --------------------------------------------------
  # Global: applies to every response including the /api/*.php JSON.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS: pailthorp.net is HTTPS-only. Apex only (no includeSubDomains /
  # preload) so this can't break any future subdomain served differently.
  Header always set Strict-Transport-Security "max-age=31536000"

  # CSP on markup only (it has no effect on JSON/CSS responses). The site is
  # same-origin ES modules with no inline script/style, no images, and all
  # fetches go to ./api/ + ./data/ — so everything locks to 'self'. The one
  # external grant: the station form submits to aviationweather.gov
  # (form-action). External radar/forecast links are plain navigation, which
  # CSP doesn't restrict. frame-ancestors replaces X-Frame-Options.
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; form-action 'self' https://aviationweather.gov; base-uri 'none'; frame-ancestors 'none'"
  </FilesMatch>

  # --- Cache policy --------------------------------------------------------
  <FilesMatch "\.(html|css|js|mjs)$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always unset Expires
    Header always unset Pragma
  </FilesMatch>

  # The lazy-loaded airport dataset is ~1 MB, fetched once per session (then
  # held in-memory by search.js) and regenerated only occasionally. A short
  # TTL lets repeat visits skip the revalidation round-trip while a regenerated
  # bundle still propagates within a day. A long max-age + immutable would be
  # better, but only once the data URL is cache-busted (hashed name / version
  # query) — it's currently served from a stable URL, so that isn't safe yet.
  <FilesMatch "airports\.json$">
    Header always set Cache-Control "public, max-age=86400, must-revalidate"
    Header always unset Expires
  </FilesMatch>
</IfModule>
